# Octofit Tracker Frontend Environment Variables Example

# REQUIRED: GitHub Codespace Name
# This variable is used to construct the API endpoint URL for the backend.
# When running in GitHub Codespaces, set this to your codespace name.
#
# Example:
#   VITE_CODESPACE_NAME=musical-spoon-954wj7wj65jfrpp
#
# The API endpoint will be constructed as:
#   https://${VITE_CODESPACE_NAME}-8000.app.github.dev/api/
#
# For local development without Codespaces, leave this unset and the 
# frontend will fall back to http://localhost:8000

VITE_CODESPACE_NAME=your-codespace-name-here
